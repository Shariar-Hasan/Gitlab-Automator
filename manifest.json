{
  "manifest_version": 3,
  "name": "GitLab Automator",
  "version": "2.0.0",
  "description": "A powerful extension for GitLab that automates the process of creating merge requests.",
  "permissions": [
    "storage",
    "cookies",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.gitlab.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitLab Automator",
    "default_icon": {
      "16": "logo/icon-16.png",
      "32": "logo/icon-32.png",
      "48": "logo/icon-48.png",
      "128": "logo/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://gitlab.com/*",
        "*://*.gitlab.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "logo/icon-16.png",
    "32": "logo/icon-32.png",
    "48": "logo/icon-48.png",
    "128": "logo/icon-128.png"
  }
}